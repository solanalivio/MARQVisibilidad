# Configuración General del Entorno
NODE_ENV=production

# Base de Datos Relacional PostgreSQL
POSTGRES_USER=marq_user
POSTGRES_PASSWORD=marq_secure_pass_2026
POSTGRES_DB=marq_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://marq_user:marq_secure_pass_2026@db:5432/marq_db?schema=public

# Backend API (NestJS)
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
