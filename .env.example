JWT_SECRET=super_secret_marq_jwt_key_enterprise_2026_change_in_production
JWT_REFRESH_SECRET=super_secret_marq_refresh_key_enterprise_2026_change_in_prod

# Semilla de Usuario Administrador Inicial
