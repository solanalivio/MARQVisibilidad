generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PipelineStatus {
  nuevo_contacto
  en_conversacion
  informacion_enviada
  visita_agendada
  en_negociacion
  cerro_operacion
  sin_interes
}

enum ClientSegment {
  inversor
  particular
}

enum Channel {
  whatsapp
  llamada
  reunion
  visita
  email
  instagram
  facebook
  sitio_web
  presencial
}

enum InteractionKind {
  contacto
  estado
  agenda
  showroom
  recontacto
}

enum VisitOutcome {
  done
  noshow
}

enum Typology {
  monoambiente
  un_dormitorio
  dos_dormitorios
  tres_dormitorios
  lote
}

enum Financing {
  contado
  cuotas_estudio
  credito_hipotecario
  vende_propiedad
}

enum InvestGoal {
  renta
  revalorizacion
}

enum Modality {
  en_pozo
  terminado
  indistinto
}

enum TaskKind {
  task
  meeting
}

enum MeetingPlace {
  estudio
  showroom
  obra
}

enum TaskSource {
  manual
  showroom
}

enum TaskCloseReason {
  completed
  replaced
  cancelled
}

enum ProjectCategory {
  edificios
  casas
  lotes
  interiorismo
  locales_comerciales
  edificios_especiales
}

enum ProjectStage {
  preventa
  obra
  posventa
  lotes
  portfolio
}

enum TargetProfile {
  vivienda
  inversion
}

enum NewsType {
  avance_obra
  disponibilidad
  promocion
  evento
  modificacion
  informacion_relevante
}

enum CampaignPlatform {
  meta_ads
  google_ads
  instagram
  otra
}

enum CampaignStatus {
  activa
  pausada
  finalizada
}

enum ShowroomEventType {
  open
  profile
  team
  visit
}

enum WebEventType {
  profile_vivienda
  profile_inversion
  visit_click
}

enum ActorType {
  user
  showroom
  system
  anonymous
}

enum AuditOutcome {
  success
  failure
}

enum MapKind {
  building
  area
}

enum MapPhase {
  reality
  future
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  passwordHash      String
  fullName          String
  isActive          Boolean        @default(true)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  assignedClients   Client[]
  interactions      Interaction[]
  showroomLinks     ShowroomLink[]

  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  name            String
  isSystem        Boolean          @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id          BigInt       @id @default(autoincrement())
  occurredAt  DateTime     @default(now())
  actorUserId String?      @db.Uuid
  actorType   ActorType    @default(user)
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  outcome     AuditOutcome @default(success)
  ip          String?
  requestId   String?

  actorUser   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_logs")
}

model Project {
  id             String                @id @default(uuid()) @db.Uuid
  slug           String                @unique
  name           String
  category       ProjectCategory
  year           String?
  statusLabel    String
  location       String
  facts          String[]
  description    String
  imageUrl       String
  imageAlt       String
  forSale        Boolean               @default(false)
  targetProfiles TargetProfile[]
  stage          ProjectStage          @default(portfolio)
  livingHint     String?
  sortOrder      Int                   @default(0)
  isPublished    Boolean               @default(true)
  totalUnits     Int?
  salesPerMonth  Float?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  team           ProjectTeamMember[]
  news           ProjectNews[]
  unitTypes      UnitType[]
  map            ProjectMapPlacement?
  campaigns      Campaign[]
  clientProjects ClientProject[]
  showroomLinkProjects ShowroomLinkProject[]
  interactions   Interaction[]
  tasks          Task[]

  @@map("projects")
}

model ProjectMapPlacement {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @unique @db.Uuid
  kind       MapKind
  lng        Float
  lat        Float
  address    String
  phase      MapPhase
  sequence   Int      @default(0)
  isFuture   Boolean  @default(false)
  floors     Int?
  size       Float?
  rotation   Float?
  radius     Float?
  lotWidth   Float?
  lotHeight  Float?
  volumes    Json?
  boulevard  Json?

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_map_placements")
}

model ProjectTeamMember {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  role        String
  description String
  imageUrl    String?
  sortOrder   Int      @default(0)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_team_members")
}

model ProjectNews {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  publishedOn DateTime @default(now())
  type        NewsType
  title       String
  body        String

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_news")
}

model UnitType {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @db.Uuid
  typology     Typology
  areaM2       Float
  priceFromUsd Decimal   @db.Decimal(12, 2)
  available    Int       @default(0)
  reserved     Int       @default(0)

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("unit_types")
}

model Campaign {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  platform      CampaignPlatform
  status        CampaignStatus   @default(activa)
  projectId     String?          @db.Uuid
  startedOn     DateTime
  spendArs      Decimal          @db.Decimal(14, 2)
  platformLeads Int              @default(0)

  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clients       Client[]

  @@map("campaigns")
}

model Client {
  id             String          @id @default(uuid()) @db.Uuid
  fullName       String
  phone          String
  email          String?
  segment        ClientSegment
  status         PipelineStatus  @default(nuevo_contacto)
  source         Channel
  campaignId     String?         @db.Uuid
  assignedUserId String?         @db.Uuid
  notes          String          @default("")
  prefTypology   Typology?
  budgetUsd      Decimal?        @db.Decimal(12, 2)
  financing      Financing?
  goal           InvestGoal?
  modality       Modality?
  units          Int?            @default(1)
  journey        String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedUser   User?           @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  projects       ClientProject[]
  interactions   Interaction[]
  tasks          Task[]
  showroomLinks  ShowroomLink[]

  @@index([status])
  @@index([assignedUserId])
  @@map("clients")
}

model ClientProject {
  clientId  String  @db.Uuid
  projectId String  @db.Uuid

  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([clientId, projectId])
  @@map("client_projects")
}

model Interaction {
  id           String          @id @default(uuid()) @db.Uuid
  clientId     String          @db.Uuid
  occurredAt   DateTime        @default(now())
  kind         InteractionKind @default(contacto)
  channel      Channel?
  note         String
  visitOutcome VisitOutcome?
  projectId    String?         @db.Uuid
  createdById  String?         @db.Uuid

  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, occurredAt(sort: Desc)])
  @@map("interactions")
}

model Task {
  id          String           @id @default(uuid()) @db.Uuid
  clientId    String           @db.Uuid
  kind        TaskKind         @default(task)
  text        String
  dueDate     DateTime
  dueTime     String?
  place       MeetingPlace?
  projectId   String?          @db.Uuid
  source      TaskSource       @default(manual)
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  closeReason TaskCloseReason?

  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId, completedAt])
  @@index([dueDate])
  @@map("tasks")
}

model ShowroomLink {
  id          String                @id @default(uuid()) @db.Uuid
  clientId    String                @db.Uuid
  tokenHash   String                @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime              @default(now())
  createdById String?               @db.Uuid

  client      Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  projects    ShowroomLinkProject[]
  events      ShowroomEvent[]

  @@map("showroom_links")
}

model ShowroomLinkProject {
  linkId    String       @db.Uuid
  projectId String       @db.Uuid

  link      ShowroomLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([linkId, projectId])
  @@map("showroom_link_projects")
}

model ShowroomEvent {
  id         String            @id @default(uuid()) @db.Uuid
  linkId     String            @db.Uuid
  occurredAt DateTime          @default(now())
  type       ShowroomEventType
  projectId  String?           @db.Uuid
  label      String

  link       ShowroomLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, occurredAt])
  @@map("showroom_events")
}

model WebEvent {
  id         String       @id @default(uuid()) @db.Uuid
  occurredAt DateTime     @default(now())
  type       WebEventType

  @@map("web_events")
}
